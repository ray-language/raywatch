// raywatch — TOML config: checks are named tables ([check.<name>]) or an array of
// tables ([[check]] with an optional `name` key, else `check<N>`); both shapes may
// be mixed (same as raygate). Check names must be unique.
import std/toml;
from std/toml import TomlValue, TomlEntry;

pub struct Check {
    name: string,
    kind: string,
    target: string,
    interval_ms: int,
    timeout_ms: int,
    expect_status: int,
}

pub struct Config {
    port: int,
    bind: string,
    db_path: string,
    webhook: string,
    checks: [Check],
}

fn get_str(entries: [TomlEntry], key: string, fallback: string) -> string {
    match (toml.toml_get(entries, key)) {
        Option.Some(v) => {
            match (v) {
                TomlValue.TStr(s) => s,
                _ => fallback,
            }
        },
        Option.None => fallback,
    }
}

fn get_int(entries: [TomlEntry], key: string, fallback: int) -> int {
    match (toml.toml_get(entries, key)) {
        Option.Some(v) => {
            match (v) {
                TomlValue.TInt(n) => n,
                _ => fallback,
            }
        },
        Option.None => fallback,
    }
}

// Check tables in order of first appearance among the `check.<id>.*` keys: `<id>` is
// the name of a `[check.<name>]` table or the index of a `[[check]]` entry.
fn check_ids(entries: [TomlEntry]) -> [string] {
    var ids: [string] = [];
    for e in entries {
        if (e.key.starts_with("check.")) {
            let rest = e.key.substring(6, e.key.len());
            match (rest.index_of(".")) {
                Option.Some(dot) => {
                    let id = rest.substring(0, dot);
                    if (!ids.contains(id)) {
                        ids.push(id);
                    }
                },
                Option.None => { },
            }
        }
    }
    ids
}

// The name of the check table `id`: a `[[check]]` entry uses its `name` key (or
// `check<N>`), a named table its own key.
fn check_name(entries: [TomlEntry], id: string, array_len: int) -> string {
    let indexed = match (parse_int(id)) {
        Option.Some(i) => i >= 0 && i < array_len,
        Option.None => false,
    };
    if (indexed) {
        get_str(entries, "check." + id + ".name", "check" + id)
    } else {
        id
    }
}

pub fn parse_config(src: string) -> Result<Config, string> {
    let entries = toml.parse_toml(src)?;
    let array_len = toml.toml_array_len(entries, "check");
    var checks: [Check] = [];
    var names: [string] = [];
    for id in check_ids(entries) {
        let name = check_name(entries, id, array_len);
        if (names.contains(name)) {
            return Result.Err("check '" + name + "' is defined twice");
        }
        names.push(name);
        let base = "check." + id + ".";
        let kind = get_str(entries, base + "type", "");
        let target = get_str(entries, base + "target", "");
        if (kind == "" || target == "") {
            return Result.Err("check '" + name + "': needs 'type' and 'target'");
        }
        if (kind != "http" && kind != "tcp" && kind != "tls" && kind != "dns" && kind != "redis") {
            return Result.Err("check '" + name + "': unknown type '" + kind + "'");
        }
        checks.push(
            Check {
                name: name,
                kind: kind,
                target: target,
                interval_ms: get_int(entries, base + "interval_ms", 10000),
                timeout_ms: get_int(entries, base + "timeout_ms", 5000),
                expect_status: get_int(entries, base + "expect_status", 200)
            }
        );
    }
    if (checks.len() == 0) {
        return Result.Err("no checks: add at least one [check.<name>] or [[check]] table");
    }
    Result.Ok(
        Config {
            port: get_int(entries, "server.port", 8090),
            bind: get_str(entries, "server.bind", "127.0.0.1"),
            db_path: get_str(entries, "server.db", "./raywatch.db"),
            webhook: get_str(entries, "server.webhook", ""),
            checks: checks
        }
    )
}

// "host:port" → (host, port); fallback used when there is no colon.
pub fn host_port(target: string, fallback_port: int) -> (string, int) {
    match (target.index_of(":")) {
        Option.Some(i) => (
            target.substring(0, i),
            parse_int(target.substring(i + 1, target.len())).unwrap_or(fallback_port)
        ),
        Option.None => (target, fallback_port),
    }
}
